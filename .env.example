# Copy to .env and fill in your keys
# NEVER commit .env to git

# Server config
HOST=0.0.0.0
PORT=8000
API_KEY=your-secure-api-key-here

# LLM providers (at least one required)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
STEPFUN_API_KEY=

# Logging
LOG_LEVEL=INFO
JSON_LOGS=false

# Optional: channels
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
