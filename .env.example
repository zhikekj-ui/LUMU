# ───────────────────────────────────────────────────────────────
# LUMU 配置样例
#
#   cp .env.example .env
#
# 这个文件是安全的、可以进版本库的样例；.env 里是你的真实密钥，
# 已在 .gitignore 中排除，永远不要提交。
#
# 提示：模型 Key 也可以在 Web 界面的「设置」里配，不改这个文件也能用。
# ───────────────────────────────────────────────────────────────

# ── 监听地址 ──
# 127.0.0.1 = 只有本机能访问，无需口令、打开即用（推荐，默认）
# 0.0.0.0   = 局域网/公网可访问，此时会自动启用访问口令，详见 SECURITY.md
HOST=127.0.0.1
PORT=38473

# ── 访问控制 ──
# 仅在对外暴露时生效；本机访问永远不需要口令。
#
# 留空 = 每次启动自动生成随机口令，写入 data/access_token 并打印在启动日志里。
# 填值 = 使用你指定的固定口令（请用足够长的随机串）。
LUMU_TOKEN=
#
# 强制认定为「对外暴露」，即使绑在 127.0.0.1 也要求口令。
# LUMU_PUBLIC=1
#
# 彻底关闭访问守卫 —— 任何能连到本服务的人都可以执行任意命令。
# 只在完全隔离的可信网络里使用，启动时会有红色警告。
# LUMU_NO_AUTH=1

# ── 模型厂商（至少配一个）──
# 支持任何 OpenAI 兼容接口，填上对应的 Base URL 即可。
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
STEPFUN_API_KEY=

# ── 日志 ──
LOG_LEVEL=INFO
JSON_LOGS=false

# ── 渠道接入（可选）──
# 也可以在 Web 界面「设置 → 渠道接入」里配置，那里改完即时生效。
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# ── 媒体生成（图像/视频，可选）──
# 图像/视频生成属于「模型能力」，这里只是各家厂商的配置入口；
# 留空即该厂商不可用，不影响主对话。
# 可选值：none | openai | dashscope | zhipu | stability | flux | kling | seedance
MEDIA_PROVIDER=none
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
STABILITY_API_KEY=
FLUX_API_KEY=
KLING_API_KEY=
SEEDANCE_API_KEY=
# 可选：覆盖各厂商默认模型/端点
# OPENAI_IMAGE_MODEL=gpt-image-1
# DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
