# ───────────────────────────────────────────────────────────────
# LUMU 配置样例
#
#   cp .env.example .env
#
# 这个文件是安全的、可以进版本库的样例；.env 里是你的真实密钥，
# 已在 .gitignore 中排除，永远不要提交。
#
# 提示：模型 Key 也可以在 Web 界面的「设置」里配，不改这个文件也能用。
# ───────────────────────────────────────────────────────────────

# ── 监听地址 ──
# 127.0.0.1 = 只有本机能访问，零门禁、打开即用（推荐，默认）
# 0.0.0.0   = 局域网/公网可访问，默认仍打开即用、零门禁（是否加固由你决定）
HOST=127.0.0.1
PORT=38473

# ── 访问控制 ──
# 产品默认「打开即用、零门禁」：访问守卫默认关闭，任何人连上即可用，
# 是否加固（加口令门禁）由使用者自行决定，框架不强制。
#
# LUMU_TOKEN  ：填值 = 启用固定口令门禁（推荐在对外暴露时使用，请用足够长随机串）。
# LUMU_PUBLIC ：=1 显式声明实例对外（反向代理场景推荐），配合 LUMU_TOKEN 使用。
# LUMU_NO_AUTH ：=1 显式关闭守卫（与默认行为一致，可留作明确声明）。
LUMU_TOKEN=
# LUMU_PUBLIC=1
# LUMU_NO_AUTH=1

# ── 模型厂商（至少配一个）──
# 支持任何 OpenAI 兼容接口，填上对应的 Base URL 即可。
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
STEPFUN_API_KEY=

# ── 日志 ──
LOG_LEVEL=INFO
JSON_LOGS=false

# ── 渠道接入（可选）──
# 也可以在 Web 界面「设置 → 渠道接入」里配置，那里改完即时生效。
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# ── 媒体生成（图像/视频，可选）──
# 图像/视频生成属于「模型能力」，这里只是各家厂商的配置入口；
# 留空即该厂商不可用，不影响主对话。
# 可选值：none | openai | dashscope | zhipu | stability | flux | kling | seedance
MEDIA_PROVIDER=none
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
STABILITY_API_KEY=
FLUX_API_KEY=
KLING_API_KEY=
SEEDANCE_API_KEY=
# 可选：覆盖各厂商默认模型/端点
# OPENAI_IMAGE_MODEL=gpt-image-1
# DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
