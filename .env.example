# Copy to .env and fill in your keys
# NEVER commit .env to git

# Server config
HOST=0.0.0.0
PORT=8000
API_KEY=your-secure-api-key-here

# LLM providers (at least one required)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
STEPFUN_API_KEY=

# Logging
LOG_LEVEL=INFO
JSON_LOGS=false

# Optional: channels
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# ── 媒体生成（图像/视频）厂商配置接口 ──
# 图像/视频生成为「模型能力」，此处仅预留各家厂商配置；留空即该厂商不可用，不影响主对话。
# 选择默认媒体厂商：none | openai | dashscope | zhipu | stability | flux | kling | seedance
MEDIA_PROVIDER=none
# 各家密钥（填哪家就配哪家；openai 复用上方 OPENAI_API_KEY）
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
STABILITY_API_KEY=
FLUX_API_KEY=
KLING_API_KEY=
SEEDANCE_API_KEY=
# 可选：覆盖各厂商默认模型/端点（示例）
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_VIDEO_MODEL=sora-2
# DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo
# DASHSCOPE_VIDEO_MODEL=wanx2.1-i2v-turbo
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
