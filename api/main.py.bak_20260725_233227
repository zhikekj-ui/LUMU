@app.get("/api/sessions")
async def list_sessions():
    """List all sessions with preview text. Handles both Session objects and dicts."""
    result = []
    for s in agent._sessions.values():
        # Support both Session objects and dicts for backward compatibility
        if hasattr(s, 'messages'):
            messages = s.messages
            sid = s.id
        elif isinstance(s, dict):
            messages = s.get("messages", [])
            sid = s.get("id", "")
        else:
            continue
        preview = ""
        for m in messages:
            if isinstance(m, dict) and m.get("role") == "user":
                preview = m.get("content", "")[:40]
                break
        result.append({
            "id": sid,
            "preview": preview,
            "message_count": len(messages),
        })
    return result


@app.get("/api/sessions/{session_id}")
async def get_session(session_id: str):
    """Get full message history for a session."""
    session = agent.get_or_create_session(session_id)
    # Handle both Session objects and dicts
    if hasattr(session, 'messages'):
        return {
            "id": session.id,
            "messages": session.messages,
        }
    elif isinstance(session, dict):
        return {
            "id": session.get("id", session_id),
            "messages": session.get("messages", []),
        }
    return {"id": session_id, "messages": []}


