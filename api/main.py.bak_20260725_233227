@limiter.limit("20/minute")
@app.post("/api/chat/stream")
async def chat_stream(req: ChatRequest, request: Request):
    """SSE streaming endpoint — yields tokens as they arrive."""
    message = _inject_attachments(req.message, req.attachments)

    async def event_generator():
        try:
            async for event in agent.stream_chat(message, req.session_id, images=req.images, voice_mode=getattr(req, 'voice_mode', False)):
                yield f"data: {json.dumps(event, ensure_ascii=False)}\n\n"
        except Exception as e:
            yield f"data: {json.dumps({'type': 'error', 'content': str(e)}, ensure_ascii=False)}\n\n"

    return StreamingResponse(
        event_generator(),
        media_type="text/event-stream",
        headers={"Cache-Control": "no-cache", "X-Accel-Buffering": "no"},
    )


