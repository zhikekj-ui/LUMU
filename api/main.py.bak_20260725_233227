def _human_size(n):
    if not n:
        return "0 B"
    try:
        n = int(n)
    except Exception:
        return str(n)
    units = ["B", "KB", "MB", "GB", "TB"]
    size = float(n)
    for u in units:
        if size < 1024 or u == units[-1]:
            return f"{size:.1f} {u}" if u != "B" else f"{int(size)} {u}"
        size /= 1024
    return f"{size:.1f} MB"


def _extract_text(path):
    """Extract text from a file by extension. Returns (text, error_or_None)."""
    import os
    ext = os.path.splitext(path)[1].lower()
    text_exts = {
        '.txt', '.md', '.markdown', '.csv', '.json', '.log', '.py', '.js', '.ts',
        '.java', '.c', '.cpp', '.h', '.hpp', '.go', '.rs', '.rb', '.php', '.sql',
        '.yaml', '.yml', '.toml', '.ini', '.cfg', '.html', '.htm', '.xml', '.rst',
        '.tex', '.sh', '.bash', '.ps1', '.r', '.scala', '.kt', '.swift', '.dart',
        '.text', '.txt',
    }
    try:
        if ext in text_exts:
            with open(path, 'r', encoding='utf-8', errors='ignore') as f:
                return f.read(), None
        if ext == '.pdf':
            try:
                import pdfplumber
                with pdfplumber.open(path) as pdf:
                    return "\n".join((p.extract_text() or "") for p in pdf.pages), None
            except ImportError:
                try:
                    from pypdf import PdfReader
                    r = PdfReader(path)
                    return "\n".join((pg.extract_text() or "") for pg in r.pages), None
                except ImportError:
                    return None, "PDF 解析需要 pdfplumber 或 pypdf 库（pip install pdfplumber）"
        if ext in ('.docx', '.doc'):
            try:
                import docx
                d = docx.Document(path)
                return "\n".join((p.text or "") for p in d.paragraphs), None
            except ImportError:
                return None, "DOCX 解析需要 python-docx 库（pip install python-docx）"
        # 兜底：尝试按文本读取
        with open(path, 'r', encoding='utf-8', errors='ignore') as f:
            return f.read(), None
    except Exception as e:
        return None, str(e)


def _chunk_text(text, size=800, overlap=80):
    if not text:
        return []
    chunks = []
    start = 0
    step = max(1, size - overlap)
    n = len(text)
    while start < n:
        seg = text[start:start + size].strip()
        if seg:
            chunks.append(seg)
        start += step
    return chunks


def _inject_attachments(message, attachments):
    """将聊天附件文本内容注入到用户消息，作为对话上下文。"""
    import os
    if not attachments:
        return message
    parts = []
    for fid in attachments:
        if not fid:
            continue
        p = os.path.join(os.getenv("AGENT_HOME", "/opt/agent-framework"), "data", "uploads", fid)
        if os.path.exists(p):
            try:
                with open(p, 'r', encoding='utf-8', errors='ignore') as f:
                    txt = f.read()
                if txt.strip():
                    parts.append(f"[附件《{fid}》内容]:\n{txt[:8000]}")
            except Exception:
                pass
    if parts:
        return (message or "") + "\n\n" + "\n\n".join(parts)
    return message


@app.post("/api/kb/upload")
async def upload_kb_document(file: UploadFile = File(...)):
    """上传文档 → 解析 → 切片 → 向量化 → 入库。返回文档记录。"""
    try:
        import os, uuid
        upload_dir = os.path.join(os.getenv("AGENT_HOME", "/opt/agent-framework"), "data", "uploads")
        os.makedirs(upload_dir, exist_ok=True)
        raw_name = file.filename or "untitled"
        safe_name = raw_name.replace("/", "_").replace("\\", "_")
        stored = f"{uuid.uuid4().hex}_{safe_name}"
        dest = os.path.join(upload_dir, stored)
        data = await file.read()
        with open(dest, 'wb') as f:
            f.write(data)
        text, err = _extract_text(dest)
        if err or not text or not text.strip():
            return JSONResponse(
                {"ok": False, "filename": safe_name, "error": err or "文件为空或无法解析为文本"},
                status_code=422,
            )
        chunks = _chunk_text(text)
        if not chunks:
            return JSONResponse(
                {"ok": False, "filename": safe_name, "error": "未提取到可索引文本内容"},
                status_code=422,
            )
        kb = _get_kb()
        ext = os.path.splitext(safe_name)[1].lower().lstrip('.') or 'txt'
        added = 0
        for i, ch in enumerate(chunks):
            kb.add(
                title=(f"{safe_name}（第{i+1}段）" if len(chunks) > 1 else safe_name),
                content=ch,
                category="document",
                tags=["upload", ext],
                source=safe_name,
                metadata={
                    "filename": safe_name, "stored": stored, "path": dest,
                    "type": ext, "size": len(data), "chunk_index": i,
                    "total_chunks": len(chunks),
                },
            )
            added += 1
        return {
            "ok": True, "filename": safe_name, "type": ext,
            "size": len(data), "size_human": _human_size(len(data)),
            "chunks": len(chunks), "indexed": added, "source": safe_name,
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/api/kb/documents")
async def list_kb_documents():
    """列出已入库文档（按 source 文件名聚合，直接读取 metadata 获取 size/type）。"""
    try:
        import os, sqlite3, json
        kb_path = _kb_db_path()
        docs = {}
        with sqlite3.connect(kb_path) as conn:
            rows = conn.execute(
                "SELECT id, title, source, metadata, updated_at FROM knowledge"
            ).fetchall()
        for row in rows:
            _id, title, src, meta_json, updated_at = row
            if not src:
                continue
            try:
                md = json.loads(meta_json) if meta_json else {}
            except Exception:
                md = {}
            if not isinstance(md, dict):
                md = {}
            d = docs.setdefault(src, {
                "name": src, "type": "txt", "size_bytes": 0,
                "status": "ready", "progress": 100, "chunks": 0,
                "updated_at": updated_at or "",
            })
            d["chunks"] += 1
            if md.get("size"):
                d["size_bytes"] = md["size"]
            if md.get("type"):
                d["type"] = md["type"]
            if updated_at and updated_at > d["updated_at"]:
                d["updated_at"] = updated_at
        out = []
        for name, d in docs.items():
            out.append({
                "name": d["name"], "type": d["type"],
                "size": _human_size(d["size_bytes"]), "size_bytes": d["size_bytes"],
                "status": d["status"], "progress": d["progress"], "chunks": d["chunks"],
                "updated_at": d["updated_at"],
            })
        out.sort(key=lambda x: x.get("updated_at") or "", reverse=True)
        return {"documents": out, "total": len(out)}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/api/kb/stats")
async def kb_statistics():
    """知识库统计。"""
    try:
        kb = _get_kb()
        s = kb.stats()
        entries = kb.list_entries(limit=100000)
        doc_sources = set()
        total_chunks = 0
        for e in entries:
            src = e.get("source")
            if not src:
                continue
            doc_sources.add(src)
            total_chunks += 1
        return {
            "total_documents": len(doc_sources),
            "total_entries": s.get("total_entries", 0),
            "indexed": len(doc_sources),
            "total_chunks": total_chunks,
            "categories": s.get("categories", 0),
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.delete("/api/kb/documents/{source}")
async def delete_kb_document(source: str):
    """按 source 文件名删除文档（删除其下所有分块）。"""
    try:
        kb = _get_kb()
        entries = kb.list_entries(limit=100000)
        deleted = 0
        for e in entries:
            if e.get("source") == source:
                kb.delete(e["id"])
                deleted += 1
        return {"ok": True, "source": source, "deleted": deleted}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


