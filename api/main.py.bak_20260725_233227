# ===== Voice API: STT & TTS direct endpoints =====

@app.post("/api/voice/transcribe")
async def transcribe_audio(file: UploadFile = File(...)):
    """Transcribe uploaded audio file to text using Whisper STT."""
    import os
    import tempfile
    import uuid

    # Read uploaded audio
    audio_bytes = await file.read()
    if not audio_bytes:
        raise HTTPException(status_code=400, detail="Empty audio file")

    # Save to temp file
    suffix = os.path.splitext(file.filename or "audio.webm")[1] or ".webm"
    tmp_dir = os.path.join(os.getenv("AGENT_HOME", "/opt/agent-framework"), "data", "audio")
    os.makedirs(tmp_dir, exist_ok=True)
    tmp_filename = f"stt_{uuid.uuid4().hex[:8]}{suffix}"
    tmp_path = os.path.join(tmp_dir, tmp_filename)

    with open(tmp_path, "wb") as f:
        f.write(audio_bytes)

    # Call stt_transcribe tool handler directly
    try:
        from tools.tts_stt import handle_stt_transcribe
        result = handle_stt_transcribe(
            audio_file=tmp_path,
            language="zh",
            provider="whisper",
        )

        # Clean up temp file
        try:
            os.remove(tmp_path)
        except Exception:
            pass

        if "error" in result:
            raise HTTPException(status_code=500, detail=result["error"])

        return {
            "success": True,
            "text": result.get("text", ""),
            "provider": result.get("provider", "whisper"),
        }
    except HTTPException:
        raise
    except Exception as e:
        # Clean up on error
        try:
            os.remove(tmp_path)
        except Exception:
            pass
        raise HTTPException(status_code=500, detail=f"STT failed: {str(e)}")


@app.post("/api/voice/tts")
async def synthesize_speech(req: dict):
    """Synthesize text to speech audio and return file URL."""
    from tools.tts_stt import handle_tts_synthesize

    text = req.get("text", "")
    voice = req.get("voice", "mimo_default")
    style = req.get("style", "")
    # 默认使用 auto 模式：先尝试 MiMo TTS，失败自动回退到 Edge TTS
    provider = req.get("provider", "auto")
    rate = req.get("rate", "+8%")
    pitch = req.get("pitch", "+2Hz")

    if not text.strip():
        raise HTTPException(status_code=400, detail="Text is empty")

    result = handle_tts_synthesize(
        text=text, voice=voice, provider=provider,
        style=style, rate=rate, pitch=pitch
    )

    if "error" in result:
        raise HTTPException(status_code=500, detail=result["error"])

    # Return audio file URL (served from /static)
    filename = result.get("filename", "")
    return {
        "success": True,
        "audio_url": f"/audio/{filename}" if filename else None,
        "filename": filename,
        "provider": result.get("provider", "edge"),
        "voice": result.get("voice", ""),
    }




@app.post("/api/config/model")
async def switch_model(req: ModelSwitchRequest):
    """Switch the active model (and optionally provider)."""
    from providers.registry import get as get_provider

    provider = get_provider(req.provider)
    if not provider:
        raise HTTPException(status_code=404, detail=f"Provider '{req.provider}' not found")
    if not req.model:
        raise HTTPException(status_code=400, detail="model 不能为空")
    # 允许任意模型名：base_url 覆盖后用户可使用任意兼容 OpenAI 的模型

    # Update agent
    if agent.provider_name != req.provider:
        agent.provider_name = req.provider
        agent.provider = provider
        # Rebuild context engine for new provider's context window
        from agent.context import ContextEngine
        agent.context = ContextEngine(context_window=provider.context_window)
    agent.model = req.model

    # Persist model preference
    set_model_preference(req.provider, req.model)

    return {
        "ok": True,
        "provider": req.provider,
        "model": req.model,
        "message": f"已切换到 {provider.display_name} / {req.model}"
    }


