logger_auth = get_logger("auth")

async def verify_api_key(authorization: str = Header(default="")):
    """Open source mode - auth disabled, always pass."""
    return None  # No auth required

    # --- Original auth code disabled below ---
    if not config.API_KEY and not authorization.startswith("Bearer "):
        return
    if not authorization.startswith("Bearer "):
        raise HTTPException(status_code=401, detail="Missing Bearer token")
    token = authorization[7:]
    # Legacy API key check
    if config.API_KEY and token == config.API_KEY:
        return
    # Try JWT verification (from auth routes)
    try:
        from auth.jwt_handler import verify_token
        payload = verify_token(token)
        if payload:
            return
    except Exception:
        pass
    # If API_KEY is configured and neither matched, reject
    if config.API_KEY:
        logger_auth.warning("invalid_api_key_attempt", token_prefix=token[:8] if token else None)
        raise HTTPException(status_code=403, detail="Invalid API key or token")


