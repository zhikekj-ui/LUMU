# 环境与密钥
.env
*.pem
*.key

# 运行时数据（含 API Key 与全部对话，绝不入库）
data/
logs/
*.db
*.db-wal
*.db-shm
*.log

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml

# 备份与临时
*.bak
*.bak_*
*.bak.*
*.orig
.edits_bak/
tmp/
*.tmp
*.tar.gz
.DS_Store

# 用户自写/安装的技能包（属于用户数据，不入库）
skills/packs/*
!skills/packs/.gitkeep

# 前端源码依赖与开发产物（构建结果在 api/static/，入库）
webui/node_modules/
webui/dist/
node_modules/
/work/
._*
